# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Which environment to test against: "hosted" (default) or "local".
# Determines baseURL/retries/timeouts via config/environments.ts.
TEST_ENV=hosted

# Optional: override the environment's default base URL for a one-off run
# (e.g. a staging deploy) without changing retry/timeout behavior.
# BASE_URL=https://automationintesting.online

# RBP admin panel credentials (defaults shipped by RBP itself for local/dev use).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
