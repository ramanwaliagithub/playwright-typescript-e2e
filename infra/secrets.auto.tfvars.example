# Copy this file to secrets.auto.tfvars (gitignored) and fill in the real value yourself —
# never paste this into chat. Terraform loads *.auto.tfvars automatically, no -var-file flag
# needed.

# GitHub PAT for CodeBuild's source credential (infra/codebuild.tf). AWS requires a linked
# GitHub credential for the GITHUB source type even on a public repo. Create one at
# https://github.com/settings/personal-access-tokens/new — fine-grained, scoped to just this
# repo (ramanwaliagithub/playwright-typescript-e2e), "Contents: Read-only" permission is enough.
github_token = "REPLACE_WITH_YOUR_GITHUB_PAT"
